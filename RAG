import re

def merge_tables_with_headers_from_markdown(md_text: str) -> list[str]:
    lines = [line.strip() for line in md_text.split("\n") if line.strip()]
    merged = []
    i = 0
    while i < len(lines):
        line = lines[i]
        # Detect potential table header (caption line followed by pipe-line)
        if not re.match(r"^\|.*\|$", line) and i + 1 < len(lines) and re.match(r"^\|.*\|$", lines[i + 1]):
            caption = line
            table_lines = []
            i += 1
            while i < len(lines) and re.match(r"^\|.*\|$", lines[i]):
                table_lines.append(lines[i])
                i += 1
            full_table = "TABLE: " + caption + " || " + " || ".join(table_lines)
            merged.append(full_table)
        else:
            merged.append(line)
            i += 1
    return merged
import re

def strip_sections_by_header(lines: list[str], headers: list[str]) -> list[str]:
    cleaned = []
    skipping = False
    # Normalize header pattern
    headers = [h.lower() for h in headers]
    for line in lines:
        line_lower = line.strip().lower()

        if skipping:
            if line_lower.startswith("##") and not any(h in line_lower for h in headers):
                skipping = False
                cleaned.append(line)
            continue

        if any(line_lower.startswith(f"## {h}") for h in headers):
            skipping = True
            continue

        if not skipping:
            cleaned.append(line)

    return cleaned
